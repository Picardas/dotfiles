{{- /* Default Values */ -}}
{{- $sourceDir := joinPath .chezmoi.homeDir ".local" "share" "chezmoi" -}}
{{- $autocrlf := "input" -}}
{{- $sshProg := "" -}}
{{- $credProg := "" -}}
{{- $credStore := "" -}}
{{- $agentSock := "" -}}
{{- $width := 132 -}}
{{- $machine := false -}}
{{- $macVM := false -}}

{{- if eq .chezmoi.os "windows" -}}
    {{- $sourceDir = joinPath .chezmoi.homeDir "AppData" "Local" "chezmoi" -}}
    {{- $autocrlf = "true" -}}
    {{- $sshProg = joinPath .chezmoi.homeDir "AppData" "Local" "Microsoft" "WindowsApps" "op-ssh-sign.exe" -}}
    {{- $credProg = "manager" -}}

{{- else if eq .chezmoi.os "darwin" -}}
    {{- $macVM = eq (output "/usr/sbin/sysctl" "-n" "kern.hv_vmm_present" | trim) "1" -}}
    {{- if $macVM -}}
        {{- $agentSock = joinPath .chezmoi.homeDir ".1password" "agent.sock" -}}
    {{- else -}}
        {{- $agentSock = joinPath .chezmoi.homeDir "Library" "Group Containers" "2BUA8C4S2C.com.1password" "t" "agent.sock" -}}
        {{- $sshProg = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign" -}}
        {{- $credProg = "/opt/homebrew/bin/git-credential-manager" -}}
        {{- $credStore = "keychain" -}}
    {{- end -}}
    {{- $width = 80 -}}

{{- else if eq .chezmoi.os "linux" -}}
    {{- if (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
        {{- $WinUserProfile := output "powershell.exe" "-Command" "Write-Output $env:USERPROFILE" | trim -}}
        {{- $WSLUserProfile := output "wslpath" $WinUserProfile | trim -}}
        {{- $sshProg = joinPath $WSLUserProfile "AppData" "Local" "Microsoft" "WindowsApps" "op-ssh-sign-wsl.exe" -}}
        {{- $credProg = joinPath $WSLUserProfile "AppData" "Local" "Microsoft" "WinGet" "Packages" "Git.MinGit_Microsoft.Winget.Source_8wekyb3d8bbwe" "ucrt64" "bin" "git-credential-manager.exe" -}}
    {{- else if stat "/etc/container-machine" -}}
        {{- $sshProg = "" -}}
        {{- $machine = true -}}
    {{- else -}}
        {{- $agentSock = joinPath .chezmoi.homeDir ".1password" "agent.sock" -}}
        {{- $sshProg = "/usr/share/1password/op-ssh-sign" -}}
        {{- $credProg = "/usr/bin/git-credential-manager" -}}
        {{- $credStore = "secretservice" -}}
    {{- end -}}
{{- end -}}
sourceDir = {{ $sourceDir | quote }}

[data]
    git_autocrlf = {{ $autocrlf | quote }}
    git_ssh_prog = {{ $sshProg | quote }}
    git_cred_prog = {{ $credProg | quote }}
    git_cred_store = {{ $credStore | quote }}
    ssh_agent_sock = {{ $agentSock | quote }}
    container_machine = {{ $machine }}
    mac_vm = {{ $macVM }}
    ghostty_win_width = {{ $width }}
