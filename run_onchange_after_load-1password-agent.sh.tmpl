{{- if and (eq .chezmoi.os "darwin") (stat "/Applications/1Password.app") -}}
#!/bin/sh
# plist hash: {{ include "private_Library/LaunchAgents/com.1password.SSH_AUTH_SOCK.plist.tmpl" | sha256sum }}
plist="$HOME/Library/LaunchAgents/com.1password.SSH_AUTH_SOCK.plist"
launchctl bootout "gui/$(id -u)/com.1password.SSH_AUTH_SOCK" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "$plist"
{{- end }}
